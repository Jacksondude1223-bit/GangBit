BOT_TOKEN=your_discord_bot_token
MAIN_GUILD_ID=123456789012345678
SUB_GUILD_IDS=234567890123456789,345678901234567890

# JSON array format.
# For each mapping group:
# - mainRoleId: role ID in your MAIN_GUILD_ID
# - mirrors: map of sub guild id -> role ID in that guild
ROLE_GROUPS=[
  {
    "mainRoleId": "111111111111111111",
    "mirrors": {
      "234567890123456789": "222222222222222222",
      "345678901234567890": "333333333333333333"
    }
  }
]
